<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" role="img" aria-labelledby="heroTitle heroDesc">
<title id="heroTitle">Wisdom Booksellers storefront at golden hour</title>
<desc id="heroDesc">Cozy independent bookstore with warm wood shelves, bay window with plants, fairy lights and stacked books</desc>
<defs>
  <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
    <stop offset="0%" stop-color="#FFF8EC"/>
    <stop offset="55%" stop-color="#F5E6C8"/>
    <stop offset="100%" stop-color="#E8D5B5"/>
  </linearGradient>
  <linearGradient id="woodGrad" x1="0" y1="0" x2="1" y2="0">
    <stop offset="0%" stop-color="#6B3A2A"/>
    <stop offset="100%" stop-color="#8B5E44"/>
  </linearGradient>
  <pattern id="paper" width="120" height="120" patternUnits="userSpaceOnUse">
    <rect width="120" height="120" fill="#FDF6E3" opacity="0.0"/>
    <circle cx="20" cy="30" r="0.7" fill="#D4C4A8" opacity="0.3"/>
    <circle cx="80" cy="90" r="0.5" fill="#D4C4A8" opacity="0.25"/>
    <circle cx="50" cy="60" r="0.6" fill="#C9A96A" opacity="0.15"/>
  </pattern>
</defs>
<rect width="1600" height="900" fill="url(#sky)"/>
<!-- wall -->
<rect x="0" y="0" width="1600" height="630" fill="#EDE0C8"/>
<rect x="0" y="0" width="1600" height="630" fill="url(#paper)" opacity="0.5"/>
